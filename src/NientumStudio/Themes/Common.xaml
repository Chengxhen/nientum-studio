  <SolidColorBrush x:Key="CheckBoxCheck" Color="#E3B85C" />
  <SolidColorBrush x:Key="SliderTrackBg" Color="#212A3E" />
  <SolidColorBrush x:Key="SliderThumbColor" Color="#E3B85C" />
