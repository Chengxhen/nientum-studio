<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NientumStudio</AssemblyName>
    <RootNamespace>NientumStudio</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <!-- 游戏安装目录，构建时通过 -p:NientumGameDir="..." 传入 -->
    <NientumGameDir Condition="'$(NientumGameDir)' == ''"></NientumGameDir>
  </PropertyGroup>

  <Target Name="RequireNientumGameDir" BeforeTargets="PrepareForBuild" Condition="'$(NientumGameDir)' == ''">
    <Error Text="缺少 NientumGameDir。示例：dotnet build -p:NientumGameDir=&quot;D:\Games\Liora&quot;" />
  </Target>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NientumGameDir)\Nientum_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NientumGameDir)\Nientum_Data\Plugins\x86_64\fmodstudio.dll">
      <Link>fmodstudio.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>