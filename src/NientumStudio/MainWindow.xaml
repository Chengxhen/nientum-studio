<Window x:Class="NientumStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:NientumStudio.Controls"
        Title="Nientum Studio · 实验版（斜轨与直线投影）"
        Width="1540" Height="940" MinWidth="1360" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- 游戏主题剧场幕布底图（仅在 Game 主题下显示） -->
    <Image x:Name="GameBackdropImage" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="0.14"
           IsHitTestVisible="False" Visibility="{DynamicResource GameThemeVisibility}" />

    <!-- ================= 顶栏 ================= -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid>
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 品牌 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
              <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource PillBg}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Margin="0,0,9,0"
                      Visibility="{DynamicResource StandardBrandVisibility}">
                <Path Data="M 9 1 L 17 9 L 9 17 L 1 9 Z" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#2EE0D8" Offset="0" />
                      <GradientStop Color="#EC74C8" Offset="1" />
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
              </Border>
              <Image x:Name="GameBrandIcon" Width="28" Height="28" Margin="0,0,9,0"
                     Visibility="{DynamicResource GameThemeVisibility}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NIENTUM STUDIO" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Op.ZERO 谱面工坊" FontSize="10" Foreground="{DynamicResource AccentGold}" Margin="0,1,0,0" />
              </StackPanel>
            </StackPanel>

            <!-- 走带控制胶囊 -->
            <Border Style="{StaticResource CommandGroupBorder}" Margin="0,0,10,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRewind" Focusable="False" Width="30" Height="28" Padding="0" ToolTip="回到起点 (Home)" Click="BtnRewind_Click" Margin="0,0,4,0">
                  <Path Data="M 1 1 L 1 9 M 9 1 L 3 5 L 9 9 Z" Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource ButtonText}" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.2" />
                </Button>
                <Button x:Name="BtnPlay" Content="▶ 播放" Width="84" Height="28" Padding="6,0" Focusable="False" Style="{StaticResource PrimaryButton}" Click="BtnPlay_Click" Margin="0,0,4,0" ToolTip="播放 / 暂停 (空格)" FontWeight="SemiBold" />
                <Button x:Name="BtnStop" Focusable="False" Width="30" Height="28" Padding="0" ToolTip="停止并回到起点" Click="BtnStop_Click">
                  <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource ButtonText}" />
                </Button>
              </StackPanel>
            </Border>

            <!-- 走带时间读数 -->
            <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="11,5" Margin="0,0,10,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentJump}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtReadout" Text="00:00.000" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentJump}" />
                <TextBlock Text="  |  " FontSize="12" Foreground="{DynamicResource TextDim}" />
                <TextBlock x:Name="TxtBeat" Text="Beat 0.00" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentGround}" />
              </StackPanel>
            </Border>

            <!-- 倍速 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="倍速" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,5,0" />
              <ComboBox x:Name="CmbRate" Width="64" Height="28" Focusable="False" SelectedIndex="2" SelectionChanged="CmbRate_SelectionChanged">
                <ComboBoxItem Content="0.5x" Tag="0.5" />
                <ComboBoxItem Content="0.75x" Tag="0.75" />
                <ComboBoxItem Content="1.0x" Tag="1.0" />
                <ComboBoxItem Content="1.25x" Tag="1.25" />
              </ComboBox>
            </StackPanel>

            <!-- 试听辅助胶囊 -->
            <Border Style="{StaticResource CommandGroupBorder}" Padding="9,4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkHitsound" Content="打击音" Focusable="False" IsChecked="True" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="播放时触发游戏原版打击音效 (H)" />
                <CheckBox x:Name="ChkMetronome" Content="节拍器" Focusable="False" IsChecked="False" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="随节拍播放节拍器 (M)" />
                <CheckBox x:Name="ChkFollow" Content="跟随指针" Focusable="False" IsChecked="True" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="播放时自动滚动时间轴跟随指针" />
                <ToggleButton x:Name="BtnLoopAB" Content="A-B" Width="46" Height="24" Padding="0" Focusable="False" Style="{StaticResource ToolToggle}" Click="BtnLoopAB_Click"
                              ToolTip="循环试听：单击定 A，再击定 B，第三击清除；快捷键 [ / ] / L" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnPanels" Content="面板" Height="29" Focusable="False" Padding="10,0" FontSize="11.5" Click="BtnPanels_Click"
                    ToolTip="显示 / 隐藏 或拆出各个侧栏面板" Margin="0,0,6,0">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="MenuPanelLibrary" Header="曲目库" IsCheckable="True" IsChecked="True" Click="MenuPanel_Click" Tag="library" />
                  <MenuItem x:Name="MenuPanelMeta" Header="难度与曲目信息" IsCheckable="True" IsChecked="True" Click="MenuPanel_Click" Tag="meta" />
                  <MenuItem x:Name="MenuPanelHealth" Header="谱面体检" IsCheckable="True" IsChecked="True" Click="MenuPanel_Click" Tag="health" />
                  <MenuItem x:Name="MenuPanelInspector" Header="属性检查器" IsCheckable="True" IsChecked="True" Click="MenuPanel_Click" Tag="inspector" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="BtnTheme" Content="深色" Height="29" Focusable="False" Padding="10,0" FontSize="11.5" Click="BtnTheme_Click"
                    ToolTip="左键循环切换：深色 / 浅色 / 游戏UI（Op.ZERO 剧场风），右键可直接选择" Margin="0,0,6,0">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="深色主题" Click="MenuTheme_Click" Tag="Dark" />
                  <MenuItem Header="浅色主题" Click="MenuTheme_Click" Tag="Light" />
                  <MenuItem Header="游戏UI · Op.ZERO 剧场风" Click="MenuTheme_Click" Tag="Game" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button Content="设置" Height="29" Focusable="False" Padding="10,0" FontSize="11.5" Click="BtnSettings_Click" Margin="0,0,10,0" ToolTip="编辑器设置" />

            <Border Style="{StaticResource CommandGroupBorder}" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnUndo" Content="↶" Width="30" Height="26" Padding="0" Focusable="False" Click="BtnUndo_Click" Margin="0,0,3,0" ToolTip="撤销 (Ctrl+Z)" />
                <Button x:Name="BtnRedo" Content="↷" Width="30" Height="26" Padding="0" Focusable="False" Click="BtnRedo_Click" ToolTip="重做 (Ctrl+Y)" />
              </StackPanel>
            </Border>

            <Button Content="保存" Width="62" Height="30" Padding="0" Focusable="False" Style="{StaticResource GoldButton}" Click="BtnSave_Click" Margin="0,0,6,0" ToolTip="保存 (Ctrl+S)" FontWeight="SemiBold" />
            <Button Content="同步到游戏" Height="30" Padding="11,0" Focusable="False" Style="{StaticResource SyncButton}" Click="BtnSync_Click" ToolTip="复制当前曲目到游戏 CustomCharts 目录" FontWeight="SemiBold" />
          </StackPanel>
        </DockPanel>
        <!-- 游戏主题顶栏底部流金细线 -->
        <Border Height="1.5" VerticalAlignment="Bottom" Margin="-14,0" IsHitTestVisible="False"
                Visibility="{DynamicResource GameThemeVisibility}">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00ECC674" Offset="0" />
              <GradientStop Color="#AAECC674" Offset="0.25" />
              <GradientStop Color="#FFECC674" Offset="0.5" />
              <GradientStop Color="#AAECC674" Offset="0.75" />
              <GradientStop Color="#00ECC674" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Grid>
    </Border>

    <!-- ================= 主体三栏 ================= -->
    <Grid x:Name="MainWorkspace" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ColLeft" Width="336" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="ColRight" Width="356" />
      </Grid.ColumnDefinitions>

      <!-- 左栏：曲目库 / 难度与曲目信息（各自可关闭、可拆出） -->
      <Border x:Name="BdLeft" Grid.Column="0" Background="{DynamicResource BgPanelStage}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 曲目库面板 -->
          <Border x:Name="LibraryHost" Grid.Row="0">
            <Grid>
              <Border x:Name="LibraryPanel" Background="{DynamicResource BgPanelStage}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="拆出" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnPopPanel_Click" Tag="library" Margin="0,0,5,0" ToolTip="把曲目库拆成独立窗口" />
                        <Button Content="关闭" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnClosePanel_Click" Tag="library" ToolTip="关闭曲目库（可在顶栏「面板」中重新打开）" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="13" CornerRadius="1.5" Background="{DynamicResource AccentGround}" Margin="0,0,8,0" />
                        <TextBlock Text="曲目库" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <Grid Grid.Row="1" Margin="12,10,12,8">
                    <TextBox x:Name="TxtSongSearch" FontSize="11.5" Padding="8,5" TextChanged="TxtSongSearch_TextChanged" ToolTip="按曲名 / 曲师 / 文件夹名搜索曲目" />
                    <TextBlock Text="筛选曲名 / 曲师 / 目录..." FontSize="11" Foreground="{DynamicResource TextDim}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtSongSearch}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>

                  <Grid Grid.Row="2" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="+ 新建" Focusable="False" Padding="6,4" FontSize="11" Style="{StaticResource PrimaryButton}" Click="BtnNewSong_Click" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="素材库" Focusable="False" Padding="6,4" FontSize="11" Click="BtnAssets_Click" Margin="0,0,6,0" ToolTip="浏览游戏解包素材" />
                    <Button Grid.Column="2" Content="官方曲目" Focusable="False" Padding="6,4" FontSize="11" Click="BtnOfficialLibrary_Click" ToolTip="从解包数据导入官方 FreePlay 谱面到本地工作区（可编辑，不写游戏）" />
                  </Grid>

                  <ListBox x:Name="LstSongs" Grid.Row="3" MaxHeight="214" SelectionChanged="LstSongs_SelectionChanged" Margin="6,0,6,6" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="6,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="2,1.5" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="打开曲目文件夹" Click="MenuOpenSongFolder_Click" />
                        <Separator />
                        <MenuItem Header="删除选中曲目" Click="MenuDeleteSong_Click" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="7" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                            <Grid>
                              <TextBlock Text="♪" FontSize="15" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding DisplaySub}" FontSize="10" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource PillBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,3,0">
                                  <TextBlock Text="{Binding BadgeAudio}" FontSize="9.5" Foreground="{DynamicResource AccentGround}" />
                                </Border>
                                <Border Background="{DynamicResource PillBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                  <TextBlock Text="{Binding BadgeSync}" FontSize="9.5" Foreground="{Binding BadgeSyncBrush}" />
                                </Border>
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <Border x:Name="LibraryPopoutHint" Background="{DynamicResource BgCard}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                  <TextBlock Text="曲目库已拆出为独立窗口" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" />
                  <Button Content="收回这里" Focusable="False" Padding="12,5" FontSize="11" HorizontalAlignment="Center" Click="BtnDockPanel_Click" Tag="library" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- 难度与曲目信息面板 -->
          <Border x:Name="MetaHost" Grid.Row="1">
            <Grid>
              <Border x:Name="MetaPanelContent" Background="{DynamicResource BgPanelStage}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="拆出" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnPopPanel_Click" Tag="meta" Margin="0,0,5,0" ToolTip="把难度与曲目信息拆成独立窗口" />
                        <Button Content="关闭" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnClosePanel_Click" Tag="meta" ToolTip="关闭此面板（可在顶栏「面板」中重新打开）" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="13" CornerRadius="1.5" Background="{DynamicResource AccentGold}" Margin="0,0,8,0" />
                        <TextBlock Text="难度与曲目信息" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="13,10,13,14">
                      <StackPanel x:Name="MetaPanel">
                        <!-- 分段难度选择栏 -->
                        <Border Style="{StaticResource CommandGroupBorder}" Margin="0,0,0,10" Padding="3">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnDiffNormal" Focusable="False" Content="Normal" Grid.Column="0" Margin="0,0,3,0" Padding="6,4" Click="BtnDiff_Click" Tag="normal" FontSize="11.5" />
                            <Button x:Name="BtnDiffHard" Focusable="False" Content="Hard" Grid.Column="1" Margin="0,0,3,0" Padding="6,4" Click="BtnDiff_Click" Tag="hard" FontSize="11.5" />
                            <Button x:Name="BtnDiffExtreme" Focusable="False" Content="Extreme" Grid.Column="2" Padding="6,4" Click="BtnDiff_Click" Tag="extreme" FontSize="11.5" />
                          </Grid>
                        </Border>

                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="难度等级（0 = 禁用）" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox x:Name="TxtDiffLevel" Text="5" TextChanged="MetaField_TextChanged" Padding="7,4" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="基准 BPM" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox x:Name="TxtBpm" Grid.Column="0" Text="120" TextChanged="TxtBpm_TextChanged" Padding="7,4" />
                              <Button Grid.Column="1" Focusable="False" Content="测速" FontSize="10.5" Padding="8,3" Margin="5,0,0,0" Click="BtnTapBpm_Click" ToolTip="跟着节拍连续点击测算 BPM" />
                            </Grid>
                          </StackPanel>
                        </Grid>

                        <TextBlock Text="曲名" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtTitle" Margin="0,0,0,8" TextChanged="MetaField_TextChanged" Padding="7,4" />

                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="曲师" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox x:Name="TxtArtist" TextChanged="MetaField_TextChanged" Padding="7,4" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="谱师" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox x:Name="TxtCharter" TextChanged="MetaField_TextChanged" Padding="7,4" />
                          </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="偏移（毫秒）" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox x:Name="TxtOffsetMs" Text="0" TextChanged="MetaField_TextChanged" Padding="7,4" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="试听起点（秒）" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox x:Name="TxtPreviewSec" Text="0" TextChanged="MetaField_TextChanged" Padding="7,4" />
                          </StackPanel>
                        </Grid>

                        <!-- 音频与封面媒体卡 -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,10">
                          <StackPanel>
                            <Grid Margin="0,0,0,8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock x:Name="TxtAudioStatus" Grid.Column="0" Text="未导入音频" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                              <Button Grid.Column="1" Focusable="False" Content="导入音频" FontSize="10.5" Padding="9,3.5" Click="BtnImportAudio_Click" />
                            </Grid>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="42" Height="42" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                  <TextBlock Text="封面" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <Image x:Name="ImgCover" Stretch="UniformToFill" />
                                </Grid>
                              </Border>
                              <TextBlock Grid.Column="1" Text="可拖拽音频/封面到此窗口" FontSize="10" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,8,0" />
                              <Button Grid.Column="2" Focusable="False" Content="导入封面" FontSize="10.5" Padding="9,3.5" VerticalAlignment="Center" Click="BtnImportCover_Click" />
                            </Grid>
                          </StackPanel>
                        </Border>

                        <Button x:Name="BtnRestoreOfficial" Focusable="False" Content="恢复官方原版（覆盖本地修改）" Visibility="Collapsed" FontSize="11" Padding="10,5" Style="{StaticResource GhostButton}" Click="BtnRestoreOfficial_Click" Margin="0,0,0,8" />
                        <TextBlock Text="导入官方谱面作参考 / 模板" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,14">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ComboBox x:Name="CmbOfficial" Grid.Column="0" Focusable="False" Margin="0,0,6,0" />
                          <Button Grid.Column="1" Focusable="False" Content="导入" Padding="12,4" FontSize="11" Click="BtnImportOfficial_Click" />
                        </Grid>

                        <Border Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,0,8" Padding="10,7">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                              <Button Content="+ 斜轨" Style="{StaticResource SmallPanelBtn}" Click="BtnAddAngledLayer_Click" Margin="0,0,4,0" ToolTip="一键新增一个带斜角的实验版轨道图层（如 +30°/-30°）" />
                              <Button Content="+ 图层" Style="{StaticResource SmallPanelBtn}" Click="BtnAddLayer_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource AccentJump}" Margin="0,0,7,0" />
                              <TextBlock Text="图层 · 斜轨实验" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="8,6">
                          <DockPanel>
                            <CheckBox x:Name="ChkSoloLayer" Content="独占模式（点击图层仅显示与修改该层）" IsChecked="True" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" ToolTip="开启后：点击任意图层卡片框，界面只显示并只允许修改该图层的音符，防止误选其他轨道" Click="ChkSoloLayer_Click" />
                          </DockPanel>
                        </Border>
                        <StackPanel x:Name="LayersPanel" />
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border x:Name="MetaPopoutHint" Background="{DynamicResource BgCard}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                  <TextBlock Text="难度与曲目信息已拆出为独立窗口" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" />
                  <Button Content="收回这里" Focusable="False" Padding="12,5" FontSize="11" HorizontalAlignment="Center" Click="BtnDockPanel_Click" Tag="meta" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- 中栏：实时画面 + 直轨投影参考框 + 工具条 + 时间轴 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="215" MinHeight="125" />
          <RowDefinition Height="4" />
          <RowDefinition x:Name="ProjectionRow" Height="96" MinHeight="72" />
          <RowDefinition Height="4" />
          <RowDefinition Height="Auto" MinHeight="42" />
          <RowDefinition Height="*" MinHeight="185" />
        </Grid.RowDefinitions>

        <Grid x:Name="PreviewHost" Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0"
                  PreviewMouseLeftButtonDown="PreviewHeader_MouseDown" PreviewMouseLeftButtonUp="PreviewHeader_MouseUp" MouseLeave="PreviewHeader_MouseLeave">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkProjLines" Content="斜轨垂线" IsChecked="True" Focusable="False" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0" Click="ChkProjOption_Click" ToolTip="在主预览内显示斜轨音符到人物直线的虚线投影" />
                <CheckBox x:Name="ChkProjBox" Content="直轨投影框" IsChecked="True" Focusable="False" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0" Click="ChkProjOption_Click" ToolTip="在预览下方显示独立的水平直轨投影参考框" />
                <TextBlock Text="分格BPM" FontSize="10.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox x:Name="TxtGridBpm" Width="48" Height="24" FontSize="10.5" Padding="5,2" Margin="0,0,10,0" ToolTip="留空 = 跟随谱面 BPM；输入数字 = 按自定义 BPM 分格" TextChanged="TxtGridBpm_TextChanged" />
                <TextBlock Text="拍/小节" FontSize="10.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox x:Name="TxtGridBeatsPerBar" Text="4" Width="32" Height="24" FontSize="10.5" Padding="5,2" Margin="0,0,10,0" TextChanged="TxtGridBpm_TextChanged" />
                <TextBlock Text="密度" FontSize="10.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="CmbPreviewGrid" Width="88" Height="24" Focusable="False" SelectedIndex="2" SelectionChanged="CmbPreviewGrid_SelectionChanged" FontSize="10.5" Margin="0,0,10,0">
                  <ComboBoxItem Content="关闭" Tag="0" />
                  <ComboBoxItem Content="1/1 拍格" Tag="1" />
                  <ComboBoxItem Content="1/2 拍格" Tag="2" />
                  <ComboBoxItem Content="1/3 拍格" Tag="3" />
                  <ComboBoxItem Content="1/4 拍格" Tag="4" />
                  <ComboBoxItem Content="1/6 拍格" Tag="6" />
                  <ComboBoxItem Content="1/8 拍格" Tag="8" />
                  <ComboBoxItem Content="1/16 拍格" Tag="16" />
                  <ComboBoxItem Content="1/24 拍格" Tag="24" />
                  <ComboBoxItem Content="1/32 拍格" Tag="32" />
                </ComboBox>
                <Button Content="弹出" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnPopPreview_Click" ToolTip="把画面预览拆成独立窗口（长按本标题栏也可以）" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="13" CornerRadius="1.5" Background="{DynamicResource AccentBlue}" Margin="0,0,8,0" />
                <TextBlock Text="实时画面" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="  ·  左键放 / 右键删" FontSize="10" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid x:Name="PreviewCanvasHost" Grid.Row="1">
            <Image x:Name="PreviewBgImage" Stretch="Fill" IsHitTestVisible="False" />
            <ctrl:PlayfieldPreviewControl x:Name="Playfield" />
            <Border x:Name="PreviewPopoutHint" Visibility="Collapsed" Background="{DynamicResource BgCard}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="画面预览已弹出为独立窗口" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                <Button Content="收回主窗口" Focusable="False" Padding="12,5" FontSize="11" Margin="0,10,0,0" HorizontalAlignment="Center" Click="BtnDockPreview_Click" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" />

        <!-- 实验版：直轨水平投影参考框（把所有斜轨音符投影到人物移动直线上） -->
        <Border x:Name="ProjectionHost" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource BgPanel}">
          <ctrl:PlayfieldPreviewControl x:Name="ProjectionBox" IsProjectionBox="True" />
        </Border>

        <GridSplitter x:Name="ProjectionSplitter" Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" />

        <!-- 编辑工具栏（右侧吸附/缩放优先固定，工具组自适应防裁剪） -->
        <Border Grid.Row="4" Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="10,6">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <TextBlock Text="吸附" FontSize="10.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <ComboBox x:Name="CmbSnap" Width="58" Height="25" Focusable="False" SelectedIndex="3" SelectionChanged="CmbSnap_SelectionChanged" Margin="0,0,10,0" FontSize="10.5">
                <ComboBoxItem Content="1/1" Tag="1" />
                <ComboBoxItem Content="1/2" Tag="2" />
                <ComboBoxItem Content="1/3" Tag="3" />
                <ComboBoxItem Content="1/4" Tag="4" />
                <ComboBoxItem Content="1/6" Tag="6" />
                <ComboBoxItem Content="1/8" Tag="8" />
                <ComboBoxItem Content="1/12" Tag="12" />
                <ComboBoxItem Content="1/16" Tag="16" />
                <ComboBoxItem Content="1/24" Tag="24" />
                <ComboBoxItem Content="1/32" Tag="32" />
                <ComboBoxItem Content="自由" Tag="0" />
              </ComboBox>
              <TextBlock Text="缩放" FontSize="10.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,5,0" />
              <Slider x:Name="SldZoom" Width="74" Focusable="False" Minimum="60" Maximum="720" Value="180" VerticalAlignment="Center" ValueChanged="SldZoom_ValueChanged" ToolTip="时间轴缩放（Ctrl+滚轮），预览同步缩放" />
            </StackPanel>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource CommandGroupBorder}" Margin="0,1,8,1" Padding="2.5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ToggleButton x:Name="TglSelect" Content="1 选择" Tag="Select" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" Margin="0,0,2,0" />
                  <ToggleButton x:Name="TglCrystal" Content="2 普通" Tag="Crystal" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" Margin="0,0,2,0" />
                  <ToggleButton x:Name="TglDodge" Content="3 闪避" Tag="Dodge" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" Margin="0,0,2,0" />
                  <ToggleButton x:Name="TglOrb" Content="4 长条" Tag="Orb" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" Margin="0,0,2,0" />
                  <ToggleButton x:Name="TglMultiHit" Content="5 连打" Tag="MultiHit" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" Margin="0,0,2,0" />
                  <ToggleButton x:Name="TglCoin" Content="6 金币" Tag="Coin" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" Margin="0,0,2,0" />
                  <ToggleButton x:Name="TglSuperJump" Content="7 大跳" Tag="SuperJump" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" Margin="0,0,2,0" />
                  <ToggleButton x:Name="TglEvent" Content="8 事件" Tag="Event" Focusable="False" Style="{StaticResource ToolToggle}" Padding="6,3" FontSize="10.5" Click="BtnTool_Click" />
                </StackPanel>
              </Border>

              <CheckBox x:Name="ChkAutoMiddle" Content="自动中段" Focusable="False" IsChecked="True" FontSize="10.5" VerticalAlignment="Center" Margin="0,2,8,2" ToolTip="新建长条时按整拍自动补中段判定点" />
              <Button Content="翻转 (F)" Focusable="False" Padding="7,3" FontSize="10.5" Click="BtnFlipLanes_Click" Margin="0,1,4,1" ToolTip="反转选中音符所在的上下轨 (F)" />
              <Button Content="设为曲终" Focusable="False" Padding="7,3" FontSize="10.5" Click="BtnSetEndOfTrack_Click" Margin="0,1,4,1" />
              <Button Content="弹出" Focusable="False" Padding="7,3" FontSize="10.5" Click="BtnPopTimeline_Click" Margin="0,1,0,1" ToolTip="把时间轴拆成独立窗口" />
            </WrapPanel>
          </DockPanel>
        </Border>

        <Grid x:Name="TimelineHost" Grid.Row="5">
          <ctrl:TimelineControl x:Name="Timeline" />
          <Border x:Name="TimelinePopoutHint" Visibility="Collapsed" Background="{DynamicResource BgCard}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="时间轴已弹出为独立窗口" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
              <Button Content="收回主窗口" Focusable="False" Padding="12,5" FontSize="11" Margin="0,10,0,0" HorizontalAlignment="Center" Click="BtnDockTimeline_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- 右栏：谱面体检 / 属性检查器（各自可关闭、可拆出） -->
      <Border x:Name="BdRight" Grid.Column="2" Background="{DynamicResource BgPanelStage}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 谱面体检面板 -->
          <Border x:Name="HealthHost" Grid.Row="0">
            <Grid>
              <Border x:Name="HealthPanel" Background="{DynamicResource BgPanelStage}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PillBg}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,7,0">
                          <TextBlock x:Name="TxtLevelBadge" Text="难度 —" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGold}" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="拆出" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnPopPanel_Click" Tag="health" Margin="0,0,5,0" ToolTip="把谱面体检拆成独立窗口" />
                        <Button Content="关闭" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnClosePanel_Click" Tag="health" ToolTip="关闭谱面体检（可在顶栏「面板」中重新打开）" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="13" CornerRadius="1.5" Background="{DynamicResource AccentGreen}" Margin="0,0,8,0" />
                        <TextBlock Text="谱面体检" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <StackPanel Grid.Row="1" Margin="14,12,14,12">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Style="{StaticResource StatMiniCard}" Margin="0,0,6,0">
                        <StackPanel>
                          <TextBlock Text="音符总数" FontSize="10" Foreground="{DynamicResource TextDim}" />
                          <TextBlock x:Name="TxtStatTotal" Text="0" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentGround}" Margin="0,2,0,0" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Style="{StaticResource StatMiniCard}" Margin="0,0,6,0">
                        <StackPanel>
                          <TextBlock Text="均 / 峰 NPS" FontSize="10" Foreground="{DynamicResource TextDim}" />
                          <TextBlock x:Name="TxtStatNps" Text="0.0 / 0.0" FontFamily="Consolas" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AccentGold}" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Style="{StaticResource StatMiniCard}">
                        <StackPanel>
                          <TextBlock Text="事件 / 末音符" FontSize="10" Foreground="{DynamicResource TextDim}" />
                          <TextBlock x:Name="TxtStatMisc" Text="0 · 0.0s" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock x:Name="TxtStats" FontSize="10.5" LineHeight="17" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Text="水晶 0 · 闪避 0 · 长条 0 · 连打 0 · 金币 0 · 大跳 0" Margin="2,0,2,8" />
                    <ctrl:NpsGraphControl x:Name="NpsGraph" Height="62" ToolTip="每秒物量（NPS）曲线" />
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                      <StackPanel x:Name="IssuesPanel" />
                    </ScrollViewer>
                    <Button x:Name="BtnFixMiddles" Focusable="False" Content="一键补全所有长条中段" FontSize="11" Padding="10,5" Margin="0,8,0,0" Click="BtnFixMiddles_Click" ToolTip="为跨度 ≥ 2 拍的长条按整拍生成中段判定点" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="HealthPopoutHint" Background="{DynamicResource BgCard}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                  <TextBlock Text="谱面体检已拆出为独立窗口" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" />
                  <Button Content="收回这里" Focusable="False" Padding="12,5" FontSize="11" HorizontalAlignment="Center" Click="BtnDockPanel_Click" Tag="health" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- 属性检查器面板 -->
          <Border x:Name="InspectorHost" Grid.Row="1">
            <Grid>
              <Border x:Name="InspectorPanelContent" Background="{DynamicResource BgPanelStage}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnDeleteSelected" Focusable="False" Content="删除选中" Style="{StaticResource DangerButton}" FontSize="10.5" Padding="8,2" IsEnabled="False" Click="BtnDeleteSelected_Click" Margin="0,0,6,0" />
                        <Button Content="拆出" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnPopPanel_Click" Tag="inspector" Margin="0,0,5,0" ToolTip="把属性检查器拆成独立窗口" />
                        <Button Content="关闭" Focusable="False" Style="{StaticResource SmallPanelBtn}" Click="BtnClosePanel_Click" Tag="inspector" ToolTip="关闭属性检查器（可在顶栏「面板」中重新打开）" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="13" CornerRadius="1.5" Background="{DynamicResource AccentJump}" Margin="0,0,8,0" />
                        <TextBlock Text="属性检查器" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InspectorPanel" Margin="14,12,14,16" />
                  </ScrollViewer>
                  <StackPanel Grid.Row="2">
                    <Border Background="{DynamicResource CardHeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="14,8">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource AccentGold}" Margin="0,0,8,0" />
                        <TextBlock Text="在指针处添加演出事件" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                    <StackPanel Margin="14,10,14,12">
                      <ComboBox x:Name="CmbNewEvent" Focusable="False" SelectedIndex="1" Margin="0,0,0,8" />
                      <Button Content="添加到指针位置" Focusable="False" Style="{StaticResource PrimaryButton}" Padding="10,6" Click="BtnAddEventAtPlayhead_Click" FontWeight="SemiBold" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="InspectorPopoutHint" Background="{DynamicResource BgCard}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                  <TextBlock Text="属性检查器已拆出为独立窗口" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" />
                  <Button Content="收回这里" Focusable="False" Padding="12,5" FontSize="11" HorizontalAlignment="Center" Click="BtnDockPanel_Click" Tag="inspector" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= 状态栏 ================= -->
    <Border Grid.Row="2" Background="{DynamicResource StatusBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="空格 播放 · 拖动标尺跳转 · 1–8 工具 · ← → 微调 · Ctrl+滚轮 缩放" FontSize="10.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,4,0" />
        <TextBlock x:Name="TxtFps" DockPanel.Dock="Right" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource AccentGold}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="编辑器实际绘制帧率（跟随显示器刷新率）" />
        <TextBlock x:Name="TxtStatusMsg" Text="就绪 · J/K 实时打谱 · 可直接拖入音频或封面 · 右键音符有更多操作" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
